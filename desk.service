# desk as a user service, so Approve on an issue in desk's own repo can restart it on the merged code: land.ts exits the
# process after the merge and Restart=always brings it back. Node runs the server's TypeScript as it is; main.ts installs
# packages and server.ts builds the app whenever the commit checked out needs it.
#
#   cp ~/projects/desk/desk.service ~/.config/systemd/user/desk.service
#   systemctl --user daemon-reload && systemctl --user enable --now desk
[Unit]
Description=desk, the issue workspace on 127.0.0.1:8790

[Service]
Type=simple
WorkingDirectory=%h/projects/desk
# claude, kitty, hyprctl and git live outside systemd's default PATH, and node and pnpm in volta's
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.volta/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.volta/bin/node apps/server/src/main.ts
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
