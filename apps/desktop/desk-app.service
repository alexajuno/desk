# desk's app, run all the time so that Claude's tabs work with desk's window closed, as an overnight automation needs
# (desk issue "desk as a desktop app, as Linear's, with a real Chrome inside", 2 Nov). It starts with no window:
# bin/desk-app, the launcher's desk, shows it, and closing it hides it again. Hyprland starts it at login, once the
# screen's address is in systemd's environment (~/.config/hypr/hyprland.lua, "desk's app"), since nothing starts
# graphical-session.target in this session. Stopping it closes Claude's tabs.
#
#   ~/projects/desk/apps/desktop/install.sh
[Unit]
Description=desk's app: its window and Claude's tabs
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/projects/desk/apps/desktop/node_modules/electron/dist/electron %h/projects/desk/apps/desktop --ozone-platform=wayland --hidden
Restart=on-failure
RestartSec=2
# Electron quits in a tenth of a second on its own SIGTERM, but with every one of its processes sent one at once, as
# systemd's default does, it waited on helpers already gone until systemd killed it 90 s later (2 Nov)
KillMode=mixed
TimeoutStopSec=5
